APP_NAME=ZABIDA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zabida_local
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=file
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=public

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="zabidamail.ph@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- ZABIDA Facebook Page sync -------------------------------------------
# See SETUP_AND_DEPLOYMENT_GUIDE.md Phase 1.6 for how to get a long-lived
# Page Access Token from a token with pages_show_list, pages_read_engagement,
# and pages_read_user_content permissions.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
